# ─────────────────────────────────────────────────────────────────
#  Binaa | بناء — Environment variables
#  Copy to .env for local dev. On Vercel, add each one in
#  Project → Settings → Environment Variables (Production + Preview).
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────
# PostgreSQL connection string (Neon / Supabase). Keep ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Telegram bot token from @BotFather (123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Random secret (>= 16 chars) that Telegram sends back in the
# X-Telegram-Bot-Api-Secret-Token header. Blocks spoofed webhooks.
# Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# Extra salt for hashing OTP codes at rest.
# Generate: openssl rand -hex 24
OTP_PEPPER=

# ── RECOMMENDED ──────────────────────────────────────────────────
# Bot username without @ (used to build https://t.me/<bot>?start=... links).
# If omitted the app asks Telegram's getMe once and caches it.
TELEGRAM_BOT_USERNAME=

# ── OPTIONAL ─────────────────────────────────────────────────────
# Max DB connections per serverless instance (default 5)
# DATABASE_POOL_MAX=5
# Set to "false" only for a non-TLS database
# DATABASE_SSL=false
# NEVER set this on a public deployment (echoes OTP codes to the browser)
# OTP_DEV_ECHO=0

# ── One-off: used only by `node scripts/seed-admin.mjs` ─────────
ADMIN_PHONE=0663471513
ADMIN_PASSWORD=change-me-strong
ADMIN_NAME=مدير بناء
